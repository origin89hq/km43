{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/target",
      "!**/.test-out",
      "!**/dist",
      "!packages/km43/reference"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": [
      "**",
      "!packages/km43/src/generated.ts",
      "!crates/km43/dataset-vocabulary.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/km43/src/generated.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useSimpleNumberKeys": "off"
          }
        }
      }
    }
  ]
}
