{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/generated.ts", "src/ble.ts"],
  "tsconfig": "tsconfig.json",
  "out": "reference",
  "readme": "README.md",
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "rewrittenLink": true,
    "notDocumented": true,
    "unusedMergeModuleWith": true
  }
}
